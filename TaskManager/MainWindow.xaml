<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskManager.ViewModels"
        xmlns:conv="clr-namespace:TaskManager.Converters"
        Title="業務タスク管理" Height="820" Width="1100"
        MinHeight="600" MinWidth="800"
        Background="{StaticResource BgBrush}"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- ヘッダー -->
            <RowDefinition Height="Auto"/> <!-- 日付ナビ -->
            <RowDefinition Height="Auto"/> <!-- タスク追加フォーム -->
            <RowDefinition Height="*"/>    <!-- タスク一覧 -->
            <RowDefinition Height="Auto"/> <!-- フッター集計 -->
        </Grid.RowDefinitions>

        <!-- ====== ヘッダー ====== -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="20,0">
                <TextBlock Text="業務タスク管理" Style="{StaticResource H1}"
                           Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="レポート" Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenReportCommand}"
                            Background="#5DADE2"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== 日付ナビゲーション ====== -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="◀" Style="{StaticResource IconButton}"
                            Command="{Binding PreviousDayCommand}" FontSize="16"/>
                    <TextBlock Text="{Binding DateLabel}" Style="{StaticResource H2}"
                               Margin="16,0" VerticalAlignment="Center" MinWidth="200"
                               TextAlignment="Center"/>
                    <Button Content="▶" Style="{StaticResource IconButton}"
                            Command="{Binding NextDayCommand}" FontSize="16"/>
                    <Button Content="今日" Style="{StaticResource PrimaryButton}"
                            Command="{Binding TodayCommand}" Margin="12,0,0,0"
                            Padding="10,4" FontSize="12"/>
                </StackPanel>

                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="140"/>
            </Grid>
        </Border>

        <!-- ====== タスク追加フォーム ====== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="16,12,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="タスクを追加" Style="{StaticResource H2}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ラベル行 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="タスク名 *" Style="{StaticResource Label}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="カテゴリ" Style="{StaticResource Label}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="予定開始" Style="{StaticResource Label}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="予定終了" Style="{StaticResource Label}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="予定(分)" Style="{StaticResource Label}" Margin="8,0,0,0"/>

                    <!-- 入力行 -->
                    <TextBox Grid.Row="2" Grid.Column="0"
                             Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddTaskCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,0"
                             Text="{Binding NewTaskCategory, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="例: 開発, 会議, 調査"/>
                    <TextBox Grid.Row="2" Grid.Column="2" Margin="8,0,0,0"
                             Text="{Binding NewTaskPlannedStart, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="HH:mm 例: 09:00"/>
                    <TextBox Grid.Row="2" Grid.Column="3" Margin="8,0,0,0"
                             Text="{Binding NewTaskPlannedEnd, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="HH:mm 例: 10:30"/>
                    <TextBox Grid.Row="2" Grid.Column="4" Margin="8,0,0,0"
                             ToolTip="所要予定分数（開始・終了から自動計算）">
                        <TextBox.Text>
                            <Binding Path="NewTaskPlannedMinutes" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <ExceptionValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <Button Grid.Row="2" Grid.Column="5" Content="追加" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddTaskCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ====== タスク一覧 ====== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="16,8,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="本日のタスク" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="↑" Style="{StaticResource IconButton}"
                                Command="{Binding MoveUpCommand}" ToolTip="上へ移動" FontSize="16"/>
                        <Button Content="↓" Style="{StaticResource IconButton}"
                                Command="{Binding MoveDownCommand}" ToolTip="下へ移動" FontSize="16" Margin="4,0,0,0"/>
                        <Button Content="削除" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteTaskCommand}" Margin="8,0,0,0"
                                Padding="10,4" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- タスクリスト -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Tasks}"
                         SelectedItem="{Binding SelectedTask}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent"
                                                BorderBrush="{StaticResource BorderBrush2}"
                                                BorderThickness="1" CornerRadius="4">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#EBF5FB"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F8FBFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6"/>    <!-- ステータスバー -->
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>    <!-- タスク情報 -->
                                    <ColumnDefinition Width="160"/>  <!-- 時間情報 -->
                                    <ColumnDefinition Width="200"/>  <!-- ボタン群 -->
                                </Grid.ColumnDefinitions>

                                <!-- ステータスカラーバー -->
                                <Border Grid.Column="0" CornerRadius="3"
                                        Background="{Binding Status, Converter={StaticResource StatusToColor}}"/>

                                <!-- タスク情報 -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#EBF3FB" CornerRadius="3" Padding="4,1"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding Category, Converter={StaticResource BoolToVis}, ConverterParameter=notempty}">
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="予定: " Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding PlannedTimeDisplay}"
                                                   Style="{StaticResource Label}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" ｜ " Style="{StaticResource Label}"/>
                                        <TextBlock Text="実績: " Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding ActualTimeDisplay}"
                                                   Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text=" ｜ " Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding DiffDisplay}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <!-- ステータスバッジ -->
                                    <Border CornerRadius="3" Padding="4,1" Margin="0,3,0,0" HorizontalAlignment="Left"
                                            Background="{Binding Status, Converter={StaticResource StatusToColor}}">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <!-- ボタン群 -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- 開始ボタン -->
                                    <Button Content="▶ 開始" Style="{StaticResource SuccessButton}"
                                            Command="{Binding StartCommand}"
                                            Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}"
                                            Padding="10,5"/>
                                    <!-- 一時停止ボタン -->
                                    <Button Content="⏸ 停止" Style="{StaticResource WarningButton}"
                                            Command="{Binding PauseCommand}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                            Padding="10,5"/>
                                    <!-- 完了ボタン -->
                                    <Button Content="✓ 完了" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding CompleteCommand}"
                                            Margin="4,0,0,0" Padding="10,5"/>
                                    <!-- リセットボタン -->
                                    <Button Content="↺" Style="{StaticResource GrayButton}"
                                            Command="{Binding ResetCommand}"
                                            Margin="4,0,0,0" Padding="8,5"
                                            ToolTip="タイマーをリセット"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空リストメッセージ -->
                <TextBlock Grid.Row="2" Text="タスクがありません。上のフォームから追加してください。"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Margin="0,20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ====== フッター集計 ====== -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,1,0,0" Padding="20,10" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="本日予定: " Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding TotalPlannedDisplay}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                    <TextBlock Text="本日実績: " Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding TotalActualDisplay}" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" FontSize="14"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
