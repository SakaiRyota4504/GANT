<Window x:Class="TaskManager.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskManager.ViewModels"
        Title="予実レポート" Height="700" Width="1000"
        MinHeight="500" MinWidth="700"
        Background="{StaticResource BgBrush}"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0" Text="予実レポート" Style="{StaticResource H1}"/>

        <!-- フィルターバー -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="期間:" Style="{StaticResource Label}" VerticalAlignment="Center"/>

                <RadioButton Content="週次" IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0"
                             Checked="RadioButton_Checked" Tag="0"/>
                <RadioButton Content="月次" VerticalAlignment="Center" Margin="8,0,0,0"
                             Checked="RadioButton_Checked" Tag="1"/>
                <RadioButton Content="カスタム" VerticalAlignment="Center" Margin="8,0,0,0"
                             Checked="RadioButton_Checked" Tag="2"/>

                <Separator Width="1" Background="{StaticResource BorderBrush2}" Margin="8,0"/>

                <TextBlock Text="基準日:" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding ReferenceDate, Mode=TwoWay}" Width="130" Margin="8,0,0,0"/>

                <Button Content="← 前" Style="{StaticResource GrayButton}"
                        Click="PrevPeriod_Click" Padding="8,4" Margin="8,0,0,0"/>
                <Button Content="次 →" Style="{StaticResource GrayButton}"
                        Click="NextPeriod_Click" Padding="8,4" Margin="4,0,0,0"/>
                <Button Content="今週/今月" Style="{StaticResource PrimaryButton}"
                        Click="ResetPeriod_Click" Padding="8,4" Margin="4,0,0,0"/>

                <Button Content="更新" Style="{StaticResource SuccessButton}"
                        Command="{Binding LoadCommand}" Padding="12,4" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- コンテンツ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- 左：タスク詳細 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding PeriodLabel}" Style="{StaticResource H2}"/>

                    <!-- サマリー -->
                    <Border Grid.Row="2" Background="#EBF5FB" CornerRadius="4" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="予定合計" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding TotalPlannedDisplay}" FontSize="18"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="24,0,0,0">
                                <TextBlock Text="実績合計" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding TotalActualDisplay}" FontSize="18"
                                           FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="24,0,0,0">
                                <TextBlock Text="完了タスク" Style="{StaticResource Label}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CompletedCount}" FontSize="18"
                                               FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                    <TextBlock Text=" / " FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalCount}" FontSize="18"
                                               FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- タスク一覧 DataGrid -->
                    <DataGrid Grid.Row="4"
                              ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日付" Binding="{Binding Date}" Width="90"/>
                            <DataGridTextColumn Header="カテゴリ" Binding="{Binding Category}" Width="90"/>
                            <DataGridTextColumn Header="タスク名" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="予定" Binding="{Binding PlannedDisplay}" Width="70"/>
                            <DataGridTextColumn Header="実績" Binding="{Binding ActualDisplay}" Width="70"/>
                            <DataGridTextColumn Header="差異" Binding="{Binding DiffDisplay}" Width="80"/>
                            <DataGridTextColumn Header="状態" Binding="{Binding StatusLabel}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 右：カテゴリ集計 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="カテゴリ別集計" Style="{StaticResource H2}"/>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding CategorySummaries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="カテゴリ" Binding="{Binding Category}" Width="*"/>
                            <DataGridTextColumn Header="予定" Binding="{Binding PlannedDisplay}" Width="55"/>
                            <DataGridTextColumn Header="実績" Binding="{Binding ActualDisplay}" Width="55"/>
                            <DataGridTextColumn Header="件数" Binding="{Binding TaskCount}" Width="40"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
